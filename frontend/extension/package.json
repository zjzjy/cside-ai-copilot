{
  "name": "cside-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.content.config.ts",
    "build:demo": "vite build --config vite.demo.config.ts",
    "lint": "oxlint && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test --project=component --project=full-chain",
    "test:e2e:component": "playwright test --project=component",
    "test:e2e:full": "playwright test --project=full-chain",
    "verify:dist": "node scripts/check-dist.mjs",
    "verify": "npm run test && npm run lint && npm run format:check && npm run build && npm run verify:dist",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/chrome": "^0.1.32",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "oxlint": "^1.71.0",
    "prettier": "^3.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.1.1",
    "vitest": "^4.0.18"
  }
}

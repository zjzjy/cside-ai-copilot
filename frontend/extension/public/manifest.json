{
  "manifest_version": 3,
  "name": "CSide 智能客服助手",
  "description": "电商代运营场景的 AI 客服侧边栏，提供店铺上下文识别与五步话术建议。",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "clipboardWrite", "sidePanel", "storage"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.taobao.com/*",
    "https://*.tmall.com/*",
    "https://*.jd.com/*",
    "https://*.pinduoduo.com/*",
    "https://*.yangkeduo.com/*",
    "https://*.douyin.com/*",
    "https://*.jinritemai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 CSide 侧边栏"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "capture-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "获取当前页面选中的客户消息"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.taobao.com/*",
        "https://*.tmall.com/*",
        "https://*.jd.com/*",
        "https://*.pinduoduo.com/*",
        "https://*.yangkeduo.com/*",
        "https://*.douyin.com/*",
        "https://*.jinritemai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
